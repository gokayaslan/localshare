{
  "name": "localshare-desktop",
  "version": "1.0.0",
  "description": "LocalShare: telefon ile bilgisayar arasında dosya, fotoğraf ve metin aktar",
  "main": "main.js",
  "author": "gokayaslan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.gokayaslan.localshare",
    "productName": "LocalShare",
    "directories": { "output": "dist" },
    "files": ["main.js", "web/**/*", "package.json"],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LocalShare",
      "artifactName": "LocalShare-Setup-${version}.exe"
    }
  }
}
